# Copy this file to `.env` and fill in your own credentials.
# Never commit the real `.env` file.

# --- RapidAPI (server-side only, read by server/index.js) ---
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=project-gutenberg-free-books-api1.p.rapidapi.com
PORT=8787

# --- Supabase (browser-side; anon key is safe to expose) ---
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
